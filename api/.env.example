# 백엔드 전용. 비밀값은 여기(로컬 .env)와 Railway 환경변수에만 둔다.

# 허용할 프론트 origin (쉼표 구분)
CORS_ORIGINS=http://localhost:5173
# 추가로 허용할 origin 정규식. Railway에는 Vercel PR Preview 도메인을 넣는다:
#   https://lunar-margin-[a-z0-9-]+-theolee021s-projects\.vercel\.app
CORS_ORIGIN_REGEX=
# NASA 데이터 저장 경로 (배포: Railway Volume 마운트 경로)
DATA_DIR=data
# Supabase (필요해질 때만 사용. service_role 키는 절대 프론트로 보내지 말 것)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 예약 저장소: Supabase Postgres의 직접 연결 또는 session pooler DSN (백엔드 전용)
RESERVATION_DATABASE_URL=
# 운영자가 화면에서 입력하는 공유 토큰. VITE_ 변수로 설정하지 않는다.
RESERVATION_ADMIN_TOKEN=
